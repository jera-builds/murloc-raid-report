# Keep LF line endings everywhere, including on Windows checkouts.
#
# This matters more than usual here: the pipeline's verification step confirms the built
# index.html is *byte-identical* to a fresh build.py run. Letting git rewrite line endings
# on checkout would break that check on Windows for reasons that have nothing to do with
# the data, and would silently alter the HTML pages exported from the project.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
